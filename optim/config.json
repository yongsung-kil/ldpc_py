{
  "_desc": "뼈대 설정. 기준 실험의 max_iter 와 채널 LLR 배율(llr_scale)을 바꿔 가며 FER 이 가장 낮은 점을 찾는다. 평가는 optim/evaluate.py 가 한다",
  "params": [
    {"name": "max_iter", "type": "int", "min": 10, "max": 60},
    {"name": "llr_scale", "type": "float", "min": 0.6, "max": 1.4, "step": 0.05}
  ],
  "evaluate": {
    "command": "python optim/evaluate.py --max_iter {max_iter} --llr_scale {llr_scale}",
    "metric_regex": "FER\\s*=\\s*([0-9.eE+-]+)",
    "minimize": true,
    "timeout_seconds": 1800
  },
  "search": {"budget": 20, "workers": 1, "seed": 1, "local_ratio": 0.5}
}
