{
  "_desc": [
    "matrix_sel_1 H-matrix, HD LLR matrix의 기준 성능 측정",
    "채널: fixed_error(HD) E=390/380/370, 포인트당 프레임 에러 20개 도달 시 종료"
  ],

  "H_matrix": {
    "dir": "../../Input/H_matrix",
    "file": "matrix_sel_1.txt"
  },

  "decoder": {
    "use_input_llr_matrix": true,
    "llr_matrix": {
      "dir": "../../Input/LLR",
      "file": "LLR_MATRIX_HD_matrix_sel_1.txt"
    }
  },

  "run": {
    "seed": 0,
    "max_frame_errors": 15,
    "max_frames": 2000000,
    "frames_per_batch": 64,
    "stop_below_fer": null,
    "progress_interval_frames": 256
  },

  "channels": {
    "type": "fixed_error",
    "fixed_error": [390, 380, 370]
  },

  "log": {
    "enabled": false,
    "items": {
      "csw_per_iter": true,
      "bit_err_per_iter": true,
      "bit_err_by_dv": true,
      "iter_histogram": true,
      "fer_vs_iter": true,
      "fail_frame_detail": true,
      "fer_curve_png": true
    }
  },

  "output": {
    "dir": "Sim_Output",
    "csv_prefix": "fer",
    "label": "matrix_sel_1_HD_fixed"
  }
}
