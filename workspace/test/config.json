{
  "_desc": [
    "실험 설정 골자: 필요한 값만 바꿔 쓴다 (스키마 정본은 2_LDPC_base/README.md)",
    "키 설명 정본: workspace/_template/config.json",
    "상대경로는 이 config 파일 위치 기준 (../../ = 2_LDPC_base)",
    "실행: 이 폴더에서 python run.py (런처가 이 config를 사용)",
    "디코더 선택은 config가 아니라 run.py의 DECODER_CLASS가 한다",
    "_로 시작하는 키는 설명용으로 코드가 무시한다 (배열도 가능)"
  ],

  "H_matrix": {
    "dir": "../../Input/H_matrix",
    "file": "example_18x147_z256.qc"
  },

  "decoder": {
    "use_input_llr_matrix": true,
    "llr_matrix": {
      "dir": "../../Input/LLR",
      "file": "LLR_MATRIX_HD_1.txt"
    },
    "mode": "HD",
    "max_iter": 30,
    "channel_llr_HD": [8],
    "channel_llr_2SD": [6, 10],
    "channel_llr_3SD": [4, 6, 8, 10],
    "use_default_edge_quantization": true,
    "edge_quantization": {
      "edge_resolution_bits": 3,
      "edge_max_value": 7
    }
  },

  "run": {
    "seed": 0,
    "max_frame_errors": 10,
    "max_frames": 256,
    "frames_per_batch": 64,
    "stop_below_fer": null,
    "progress_interval_frames": 100
  },

  "channels": {
    "type": "fixed_error",
    "rber": [0.001, 0.002],
    "fixed_error": [100, 200, 300],
    "strong_ratios": {
      "SER": 0.5,
      "SCR": 0.5
    }
  },

  "log": {
    "enabled": false,
    "items": {
      "csw_per_iter": true,
      "bit_err_per_iter": true,
      "bit_err_by_dv": true,
      "iter_histogram": true,
      "fer_vs_iter": true,
      "fail_frame_detail": true,
      "fer_curve_png": true
    }
  },

  "output": {
    "dir": "Sim_Output",
    "csv_prefix": "fer",
    "label": "test"
  }
}
