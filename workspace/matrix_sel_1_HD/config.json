{
  "_desc": [
    "matrix_sel_1 H-matrix + 짝을 이루는 HD LLR matrix의 기준 성능 측정",
    "채널: fixed_error(HD), 포인트당 프레임 에러 20개 도달 시 종료",
    "상대경로는 이 config 파일 위치 기준 (../../ = 2_LDPC_base)"
  ],

  "H_matrix": {
    "dir": "../../Input/H_matrix",
    "file": "matrix_sel_1.txt"
  },

  "decoder": {
    "use_input_llr_matrix": true,
    "llr_matrix": {
      "dir": "../../Input/LLR",
      "file": "LLR_MATRIX_HD_matrix_sel_1.txt"
    }
  },

  "run": {
    "seed": 0,
    "max_frame_errors": 20,
    "max_frames": 200000,
    "frames_per_batch": 64,
    "stop_below_fer": null,
    "progress_interval_frames": 640
  },

  "channels": {
    "type": "fixed_error",
    "fixed_error": [390, 380, 370]
  },

  "log": {
    "enabled": true,
    "items": {
      "csw_per_iter": true,
      "bit_err_per_iter": true,
      "bit_err_by_dv": true,
      "iter_histogram": true,
      "fer_vs_iter": true,
      "fail_frame_detail": true,
      "fer_curve_png": true
    }
  },

  "output": {
    "dir": "Sim_Output",
    "csv_prefix": "fer",
    "label": "matrix_sel_1_HD"
  }
}
